# Firebase configuration.
#
# Copy to `.env` and fill in from Firebase Console → Project settings → General →
# "Your apps" → Web app config. Only the EXPO_PUBLIC_ prefix is exposed to the
# client bundle, which is correct here: Firebase web config is not a secret. What
# protects the data is firestore.rules, not the obscurity of these values.
#
# The app runs fully without this file. With no config, content comes from the
# bundled seed and every mutation queues in the outbox — the same code path as
# being offline. Sign-in is the only feature that requires it.

EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FB_PROJECT_ID=your-project
EXPO_PUBLIC_FB_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FB_SENDER_ID=
EXPO_PUBLIC_FB_APP_ID=
